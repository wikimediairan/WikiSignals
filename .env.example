# Application
APP_NAME=WikiSignals
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# REQUIRED for Wikimedia APIs (HTTP 403 if missing/generic/fake contact)
# Format: AppName/version (https://your-page-or-tool; you@real-email.tld)
# Policy: https://foundation.wikimedia.org/wiki/Policy:Wikimedia_Foundation_User-Agent_Policy
USER_AGENT=WikiSignals/0.1 (https://github.com/wikimediairan/WikiSignals; you@example.org)

# Database (MariaDB / ToolsDB). SQLite is fine for local demos.
DATABASE_URL=mysql+aiomysql://wikisignals:wikisignals@127.0.0.1:3308/wikisignals
DB_POOL_RECYCLE_SECONDS=180

# Optional Redis
REDIS_URL=
REDIS_KEY_PREFIX=wikisignals:

# API
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
FRONTEND_URL=http://localhost:5173
DEFAULT_PROJECT_ID=fa.wikipedia
# Browser cache for public GET API (seconds). Keep short so post-job data shows on reload.
PUBLIC_CACHE_MAX_AGE_SECONDS=60
PUBLIC_CACHE_STALE_WHILE_REVALIDATE_SECONDS=300
DOCS_ENABLED=true

# AQS / MediaWiki HTTP client
HTTP_TIMEOUT_SECONDS=60
HTTP_MAX_RETRIES=5
HTTP_MIN_INTERVAL_SECONDS=0.5

# Ingestion defaults
INGEST_DEFAULT_MONTHS=24
INGEST_LOOKBACK_PERIODS=3

# Daily job budgets
DAILY_MAX_PROJECTS=4
DAILY_AQS_LOOKBACK_MONTHS=3
DAILY_ADMIN_LOG_DAYS=35
DAILY_ADMIN_LOG_MAX_PAGES=8
DAILY_PROJECT_PAUSE_SECONDS=3
DAILY_USE_MEDIAWIKI_LOGS=true
DAILY_USE_REPLICAS=true

# Wiki replicas (Toolforge)
WIKI_REPLICAS_ENABLED=false
